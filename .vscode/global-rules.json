{
  "globalRules": {
    "thinking": {
      "rule": "Think hard, think deep, ULTRATHINK about your task before actually executing your task",
      "enforcement": "pre-task-analysis",
      "description": "Deep analysis mandatory before any task"
    }
  },
  "language": {
    "primary": "en-US",
    "requirements": {
      "errorMessages": "English mandatory",
      "comments": "English preferred",
      "documentation": "English mandatory"
    },
    "standardTerms": {
      "user": "user",
      "users": "users",
      "system": "system",
      "status": "status",
      "profile": "profile",
      "administrator": "System Administrator"
    }
  },
  "codeStandards": {
    "apex": {
      "comments": "English only",
      "errorMessages": "English only",
      "variableNames": "camelCase English"
    },
    "lwc": {
      "labels": "English only",
      "errorMessages": "English only",
      "comments": "English only"
    },
    "validationRules": {
      "namingConvention": "VR##_ObjectName_Description",
      "errorMessageSuffix": "[VR##_ObjAbbr]",
      "sequentialPerObject": true,
      "objectAbbreviations": {
        "Opportunity": "Opp",
        "Account": "Acc",
        "Contact": "Con",
        "Lead": "Lea",
        "Case": "Cas",
        "Contract": "Ctr"
      },
      "errorMessages": "English only",
      "descriptions": "English only"
    }
  },
  "enforcement": {
    "preCommit": true,
    "preDeploy": true,
    "codeReview": true
  }
}